# Get your key from https://slng.ai/dashboard/api-keys
VOICEAI_API_KEY=

# Project UUID, sent as the X-SLNG-Project-Id header on TTS and STT requests.
# Copy it from the project's Settings page in the dashboard.
SLNG_PROJECT_ID=

# Optional: override the API base (defaults to https://api.slng.ai)
# VOICEAI_BASE_URL=https://api.slng.ai
